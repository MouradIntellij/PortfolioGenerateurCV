{
  "name": "folio-cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file=.env --import tsx backend/src/server.ts\" \"vite --config frontend/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx backend/src/server.ts",
    "db:migrate": "node --env-file=.env --import tsx backend/src/migrate.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "examples": "node --import tsx scripts/examples.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/functions": "^3.4.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
